# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). NEXT_PUBLIC_* vars are safe to expose to the
# browser - RLS is what actually protects data, not keeping the anon key
# secret. Never put the service_role key in this file; it belongs only in
# Supabase Edge Function secrets (`supabase secrets set`), never in
# anything the Next.js app ships to the client.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
